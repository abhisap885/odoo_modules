<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ai_connector_wizard_view_form" model="ir.ui.view">
            <field name="name">ai.connector.wizard.form</field>
            <field name="model">ai.connector.wizard</field>
            <field name="arch" type="xml">
                <form string="Ask AI">
                    <group>
                        <field name="provider_id" options="{'no_create': True}"/>
                        <field name="template_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="question" placeholder="Type your question or instruction..."/>
                    </group>
                    <group invisible="answer == False">
                        <field name="answer" nolabel="1" readonly="1" widget="text"/>
                    </group>
                    <footer>
                        <button name="action_ask" type="object" string="Ask AI"
                                class="btn-primary"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_ai_connector_wizard" model="ir.actions.act_window">
            <field name="name">Ask AI</field>
            <field name="res_model">ai.connector.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="ai_connector_wizard_view_form"/>
        </record>

        <menuitem id="menu_ai_connector_wizard"
                  name="Ask AI"
                  parent="menu_ai_connector_root"
                  action="action_ai_connector_wizard"
                  sequence="10"/>
    </data>
</odoo>
