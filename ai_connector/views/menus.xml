<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <menuitem id="menu_ai_connector_root"
                  name="AI Connector"
                  sequence="20"
                  web_icon="ai_connector,static/description/icon.png"/>

        <menuitem id="menu_ai_connector_config"
                  name="Configuration"
                  parent="menu_ai_connector_root"
                  sequence="10"
                  groups="ai_connector.group_manager"/>

        <menuitem id="menu_ai_provider"
                  name="Providers"
                  parent="menu_ai_connector_config"
                  action="ai_provider_action"
                  sequence="10"
                  groups="ai_connector.group_manager"/>

        <menuitem id="menu_ai_prompt_template"
                  name="Prompt Templates"
                  parent="menu_ai_connector_config"
                  action="ai_prompt_template_action"
                  sequence="20"
                  groups="ai_connector.group_manager"/>

        <menuitem id="menu_ai_product_knowledge"
                  name="Product Knowledge (RAG)"
                  parent="menu_ai_connector_config"
                  action="ai_product_embedding_action"
                  sequence="30"
                  groups="ai_connector.group_manager"/>

        <menuitem id="menu_ai_index_all"
                  name="Index All Products"
                  parent="menu_ai_product_knowledge"
                  action="action_index_all_products"
                  sequence="10"
                  groups="ai_connector.group_manager"/>

        <menuitem id="menu_ai_chat"
                  name="My Chats"
                  parent="menu_ai_connector_root"
                  action="ai_chat_action"
                  sequence="30"/>

        <record id="action_ai_chat_widget" model="ir.actions.client">
            <field name="name">AI Assistant</field>
            <field name="tag">ai_connector_chat</field>
        </record>

        <menuitem id="menu_ai_chat_widget"
                  name="AI Assistant"
                  parent="menu_ai_connector_root"
                  action="action_ai_chat_widget"
                  sequence="20"/>
    </data>
</odoo>
