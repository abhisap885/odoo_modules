<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Live chat channel AI configuration -->
        <record id="im_livechat_channel_ai_form" model="ir.ui.view">
            <field name="name">im_livechat.channel.ai.form</field>
            <field name="model">im_livechat.channel</field>
            <field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <div class="oe_title">
                        <h2>AI Auto-Reply (RAG)</h2>
                    </div>
                    <group>
                        <field name="ai_enabled" widget="boolean_toggle"/>
                        <field name="ai_provider_id" options="{'no_create': True}"
                               invisible="ai_enabled == False"/>
                        <field name="ai_rag" invisible="ai_enabled == False"/>
                        <field name="ai_rag_top_k"
                               invisible="ai_enabled == False or ai_rag == False"/>
                        <field name="ai_fallback_general"
                               invisible="ai_enabled == False or ai_rag == False"/>
                        <field name="ai_temperature"
                               invisible="ai_enabled == False"/>
                        <field name="ai_max_tokens"
                               invisible="ai_enabled == False"/>
                    </group>
                    <group invisible="ai_enabled == False">
                        <field name="ai_system_prompt" nolabel="1" placeholder="System prompt..."/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
