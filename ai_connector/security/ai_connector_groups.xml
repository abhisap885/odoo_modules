<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="privilege_ai_connector" model="res.groups.privilege">
            <field name="name">AI Connector</field>
            <field name="category_id" ref="base.module_category_productivity"/>
        </record>

        <record id="group_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_ai_connector"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can use AI chat and prompt templates.</field>
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_ai_connector"/>
            <field name="implied_ids" eval="[(4, ref('ai_connector.group_user'))]"/>
            <field name="comment">Can configure providers and prompt templates.</field>
        </record>
    </data>
</odoo>
