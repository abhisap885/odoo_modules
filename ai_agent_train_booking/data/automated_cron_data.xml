<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_auto_process_agent_tasks" model="ir.cron">
            <field name="name">AI Agent: Process Automated Train Booking Queue</field>
            <field name="model_id" ref="model_ai_agent_task"/>
            <field name="state">code</field>
            <field name="code">
pending_tasks = model.search([('state', '=', 'draft')], limit=5)
for task in pending_tasks:
    task.action_run()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
