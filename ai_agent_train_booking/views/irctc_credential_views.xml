<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_irctc_credential_list" model="ir.ui.view">
        <field name="name">irctc.credential.list</field>
        <field name="model">irctc.credential</field>
        <field name="arch" type="xml">
            <list string="IRCTC Accounts &amp; Gateways">
                <field name="name"/>
                <field name="username"/>
                <field name="integration_mode" widget="badge"/>
                <field name="upi_id"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'draft'" decoration-danger="state == 'error'"/>
                <field name="last_verification"/>
            </list>
        </field>
    </record>

    <record id="view_irctc_credential_form" model="ir.ui.view">
        <field name="name">irctc.credential.form</field>
        <field name="model">irctc.credential</field>
        <field name="arch" type="xml">
            <form string="IRCTC Account Credentials">
                <header>
                    <button name="action_test_connection" string="Test Connection / Verify" type="object" class="btn-primary" icon="fa-check-circle"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Account Description"/>
                        <h1>
                            <field name="name" placeholder="e.g. My Personal IRCTC Account"/>
                        </h1>
                    </div>
                    <group>
                        <group string="IRCTC Portal Login Credentials">
                            <field name="username" placeholder="e.g. my_irctc_user"/>
                            <field name="password" password="True"/>
                            <field name="mobile_number" placeholder="Registered 10-digit mobile number"/>
                            <field name="upi_id" placeholder="e.g. username@okhdfcbank"/>
                        </group>
                        <group string="Booking Mode &amp; Safety">
                            <field name="integration_mode"/>
                            <field name="captcha_solving_mode"/>
                            <field name="last_verification" readonly="1"/>
                        </group>
                    </group>

                    <group string="Live Indian Railways API Settings" invisible="integration_mode != 'api'">
                        <field name="api_key" password="True"/>
                        <field name="api_host"/>
                    </group>

                    <notebook>
                        <page string="Compliance &amp; Regulations" name="notes">
                            <field name="notes" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_irctc_credential" model="ir.actions.act_window">
        <field name="name">IRCTC Accounts</field>
        <field name="res_model">irctc.credential</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add an IRCTC user account to enable real-world automated ticket bookings.
            </p>
        </field>
    </record>
</odoo>
