<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Category -->
        <record id="module_category_shopify_connector" model="ir.module.category">
            <field name="name">Shopify Connector</field>
            <field name="description">Access management for Shopify Odoo Connector</field>
            <field name="sequence">25</field>
        </record>

        <!-- 2. Odoo 19 Privilege Layer (res.groups.privilege) -->
        <record id="privilege_shopify_connector" model="res.groups.privilege">
            <field name="name">Shopify Management Privileges</field>
            <field name="category_id" ref="module_category_shopify_connector"/>
        </record>

        <!-- 3. Security Groups (linking via privilege_id) -->
        <record id="group_shopify_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_shopify_connector"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('sales_team.group_sale_salesman')),
            ]"/>
        </record>

        <record id="group_shopify_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_shopify_connector"/>
            <field name="implied_ids" eval="[
                (4, ref('group_shopify_user')),
                (4, ref('sales_team.group_sale_manager')),
                (4, ref('stock.group_stock_manager')),
            ]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
