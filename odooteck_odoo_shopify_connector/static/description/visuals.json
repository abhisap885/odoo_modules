{
  "schema": "ot-visuals/1",
  "module": "odooteck_odoo_shopify_connector",
  "theme": "daybreak",
  "odoo": {
    "base_url": "${ODOO_BASE_URL}",
    "db": "${ODOO_DB}"
  },
  "capture": {
    "viewport": {"width": 1440, "height": 900},
    "device_scale_factor": 2,
    "settle_ms": 1500,
    "hide": [".o_user_menu", ".o_mail_systray_item", ".o_debug_manager", ".o_database_expiration_panel", ".o_menu_systray"]
  },
  "shots": [
    {"id": "stores", "recipe": {"kind": "action", "xmlid": "odooteck_odoo_shopify_connector.action_shopify_instance"}, "verified": {"by": "playwright", "at": "2026-09-24", "url": "/odoo/action-odooteck_odoo_shopify_connector.action_shopify_instance", "breadcrumb": "Shopify Stores", "rows": 2}, "expect": {"selector": ".o_kanban_view", "min_records": 2}},
    {"id": "insights", "recipe": {"kind": "action", "xmlid": "odooteck_odoo_shopify_connector.action_shopify_store_insights"}, "verified": {"by": "playwright", "at": "2026-09-24", "url": "/odoo/action-odooteck_odoo_shopify_connector.action_shopify_store_insights", "breadcrumb": "Store Insights", "rows": 3}, "expect": {"selector": ".shopify-insights-container", "min_records": 1}},
    {"id": "feeds", "recipe": {"kind": "action", "xmlid": "odooteck_odoo_shopify_connector.action_shopify_feed"}, "verified": {"by": "playwright", "at": "2026-09-24", "url": "/odoo/action-odooteck_odoo_shopify_connector.action_shopify_feed", "breadcrumb": "Staging Feeds", "rows": 2}, "expect": {"selector": ".o_list_view", "min_records": 2}},
    {"id": "product_mappings", "recipe": {"kind": "action", "xmlid": "odooteck_odoo_shopify_connector.action_shopify_template_mapping"}, "verified": {"by": "playwright", "at": "2026-09-24", "url": "/odoo/action-odooteck_odoo_shopify_connector.action_shopify_template_mapping", "breadcrumb": "Product Mappings", "rows": 3}, "expect": {"selector": ".o_list_view", "min_records": 3}},
    {"id": "order_mappings", "recipe": {"kind": "action", "xmlid": "odooteck_odoo_shopify_connector.action_shopify_order_mapping"}, "verified": {"by": "playwright", "at": "2026-09-24", "url": "/odoo/action-odooteck_odoo_shopify_connector.action_shopify_order_mapping", "breadcrumb": "Order Mappings", "rows": 3}, "expect": {"selector": ".o_list_view", "min_records": 3}},
    {"id": "history", "recipe": {"kind": "action", "xmlid": "odooteck_odoo_shopify_connector.action_shopify_sync_history"}, "verified": {"by": "playwright", "at": "2026-09-24", "url": "/odoo/action-odooteck_odoo_shopify_connector.action_shopify_sync_history", "breadcrumb": "Sync History", "rows": 5}, "expect": {"selector": ".o_list_view", "min_records": 5}}
  ],
  "images": [
    {"id": "hero", "target": "hero-image.png", "diagram": {"storyboard": [
      {"id": "store", "kind": "group", "label": "Shopify Store", "items": [{"id": "shop", "kind": "node", "label": "Products, orders, customers", "icon": "globe"}]},
      {"id": "staging", "kind": "group", "label": "Staging Feed", "items": [{"id": "queue", "kind": "node", "label": "Review and process feeds", "icon": "database"}]},
      {"id": "odoo", "kind": "group", "label": "Odoo 19", "items": [{"id": "core", "kind": "node", "label": "Mapped business records", "icon": "cogs"}]},
      {"id": "flow1", "kind": "link", "from": "store", "to": "staging", "label": "Inbound data"},
      {"id": "flow2", "kind": "link", "from": "staging", "to": "odoo", "label": "Validated processing"}
    ]}},
    {"id": "ss1", "target": "screenshots/SS1.png", "capture": "stores", "shows": "Shopify store instances with setup progress and synchronization counts"},
    {"id": "ss2", "target": "screenshots/SS2.png", "capture": "insights", "shows": "Store Insights dashboard with demo orders revenue and fulfillment charts"},
    {"id": "ss3", "target": "screenshots/SS3.png", "capture": "feeds", "shows": "Staging Feeds list with product and order records"},
    {"id": "ss4", "target": "screenshots/SS4.png", "capture": "product_mappings", "shows": "Shopify Product Mappings with Odoo products and Shopify identifiers"},
    {"id": "ss5", "target": "screenshots/SS5.png", "capture": "order_mappings", "shows": "Shopify Order Mappings linked to Odoo sales orders and customers"},
    {"id": "ss6", "target": "screenshots/SS6.png", "capture": "history", "shows": "Synchronization History with import export and webhook results"}
  ]
}
