<odoo>
    <record id="view_ot_livechat_channel_form" model="ir.ui.view"><field name="name">im_livechat.channel.ot.ai</field><field name="model">im_livechat.channel</field><field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/><field name="arch" type="xml"><xpath expr="//sheet/notebook" position="before"><group string="AI Assistant" groups="odooteck_ai_assistant.group_ai_manager"><field name="ot_ai_bot_id"/></group></xpath></field></record>
    <record id="view_ot_discuss_channel_form" model="ir.ui.view"><field name="name">discuss.channel.ot.ai.form</field><field name="model">discuss.channel</field><field name="arch" type="xml"><form string="AI Discuss Channel"><sheet><group><field name="name"/><field name="channel_type" invisible="1"/><field name="ot_ai_bot_id"/><field name="ot_ai_session_id" readonly="1"/></group><div class="text-muted">Add members from Discuss, then send messages in the channel to get assistant replies.</div></sheet></form></field></record>
    <record id="view_ot_discuss_channel_list" model="ir.ui.view"><field name="name">discuss.channel.ot.ai.list</field><field name="model">discuss.channel</field><field name="arch" type="xml"><list><field name="name"/><field name="ot_ai_bot_id"/><field name="ot_ai_session_id"/></list></field></record>
    <record id="action_ot_discuss_channels" model="ir.actions.act_window"><field name="name">AI Discuss Channels</field><field name="res_model">discuss.channel</field><field name="view_mode">list,form</field><field name="domain">[('channel_type','=','channel')]</field><field name="context">{'default_channel_type': 'channel'}</field></record>
</odoo>
