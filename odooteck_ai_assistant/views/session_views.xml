<odoo>
    <record id="view_ot_ai_session_list" model="ir.ui.view"><field name="name">ot.ai.session.list</field><field name="model">ot.ai.session</field><field name="arch" type="xml"><list><field name="name"/><field name="source"/><field name="bot_id"/><field name="state"/><field name="message_count"/><field name="lead_id"/><field name="last_activity"/></list></field></record>
    <record id="view_ot_ai_session_form" model="ir.ui.view"><field name="name">ot.ai.session.form</field><field name="model">ot.ai.session</field><field name="arch" type="xml"><form string="AI Chat Session"><header><button name="action_summarize" string="Summarize" type="object" class="oe_highlight"/><button name="action_download_summary" string="Download summary" type="object"/></header><sheet><group><group><field name="name"/><field name="bot_id"/><field name="source"/><field name="state"/></group><group><field name="channel_id"/><field name="lead_id"/><field name="visitor_name"/><field name="visitor_email"/></group></group><notebook><page string="Messages"><field name="message_ids" readonly="1"><list><field name="create_date"/><field name="role"/><field name="body"/><field name="provider_id"/><field name="total_tokens"/><field name="cost_usd"/><field name="feedback"/></list></field></page><page string="Summary"><field name="summary" readonly="1" nolabel="1"/></page></notebook></sheet></form></field></record>
    <record id="action_ot_ai_session" model="ir.actions.act_window"><field name="name">AI Conversations</field><field name="res_model">ot.ai.session</field><field name="view_mode">list,form</field></record>
    <record id="action_ot_ai_message" model="ir.actions.act_window"><field name="name">AI Messages and Feedback</field><field name="res_model">ot.ai.message</field><field name="view_mode">list,form</field></record>
    <record id="view_ot_ai_message_list" model="ir.ui.view"><field name="name">ot.ai.message.list</field><field name="model">ot.ai.message</field><field name="arch" type="xml"><list><field name="create_date"/><field name="session_id"/><field name="role"/><field name="body"/><field name="provider_id"/><field name="total_tokens"/><field name="cost_usd"/><field name="feedback"/></list></field></record>
</odoo>
