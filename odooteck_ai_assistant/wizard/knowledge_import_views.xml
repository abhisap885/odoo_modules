<odoo>
    <record id="view_ot_ai_knowledge_import_form" model="ir.ui.view">
        <field name="name">ot.ai.knowledge.import.form</field><field name="model">ot.ai.knowledge.import</field>
        <field name="arch" type="xml"><form string="Import knowledge"><group><field name="bot_id"/><field name="file" filename="filename"/><field name="filename" invisible="1"/></group><div class="text-muted">Upload UTF-8 TXT, CSV or JSON. CSV/JSON entries need an answer; optional fields: name, question, keywords, source_url. Maximum 200 entries or 2 MB.</div><footer><button name="action_import" string="Import" type="object" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field>
    </record>
</odoo>
