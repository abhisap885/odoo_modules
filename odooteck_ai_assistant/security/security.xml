<odoo>
    <record id="privilege_ai_assistant" model="res.groups.privilege">
        <field name="name">AI Shopping Assistant</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>
    <record id="group_ai_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_ai_assistant"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_ai_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_ai_assistant"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
